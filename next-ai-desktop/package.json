{
  "name": "next-ai-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Secure Windows desktop assistant for NEXT AI",
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^39.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.nexttrader.nextai",
    "productName": "NEXT AI",
    "directories": { "output": "release" },
    "files": ["src/**/*", "package.json"],
    "win": { "target": ["nsis"], "artifactName": "NEXT-AI-Setup-${version}.${ext}" },
    "nsis": { "oneClick": false, "perMachine": false, "allowToChangeInstallationDirectory": true }
  }
}