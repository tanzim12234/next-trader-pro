{
  "name": "next-ai-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Secure Windows desktop assistant for NEXT AI",
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis",
    "test": "node --test"
  },
  "devDependencies": {
    "electron": "^39.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.nexttrader.nextai",
    "productName": "NEXT AI Desktop",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "NEXT-AI-Setup-${version}.${ext}",
      "signAndEditExecutable": true,
      "signtoolOptions": {
        "publisherName": [
          "NEXT AI"
        ]
      }
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "asarUnpack": [
      "node_modules/tesseract.js/**/*",
      "node_modules/tesseract.js-core/**/*",
      "node_modules/@napi-rs/canvas/**/*",
      "node_modules/@huggingface/transformers/**/*",
      "node_modules/onnxruntime-node/**/*",
      "node_modules/onnxruntime-web/**/*",
      "node_modules/onnxruntime-common/**/*"
    ]
  },
  "dependencies": {
    "mammoth": "^1.9.1",
    "pdf-parse": "^1.1.1",
    "@napi-rs/canvas": "^0.1.68",
    "pdfjs-dist": "^4.10.38",
    "tesseract.js": "^6.0.1",
    "@huggingface/transformers": "^3.8.1"
  }
}
